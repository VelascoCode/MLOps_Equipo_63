        "required": [
          "instances"
        ],
        "title": "BatchPredictionRequest",
        "example": {
          "instances": [
            {
              "n_tokens_content": 100,
              "n_tokens_title": 10
            },
            {
              "n_tokens_content": 40,
              "n_tokens_title": 5
